# ---- Terraform ----
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore all .tfvars files — they may contain values specific to your
# environment, and are the most likely place secrets end up by accident.
*.tfvars
*.tfvars.json

# Ignore override files (used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore any saved plan output files
*tfplan*

# ---- Editor / OS clutter ----
.vscode/
.DS_Store
Thumbs.db